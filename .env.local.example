# Supabase project credentials (Project Settings -> API)
# These are safe to expose to the browser (the anon key is gated by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Storage bucket that holds submission documents (already created in backend).
NEXT_PUBLIC_SUPABASE_DOCUMENTS_BUCKET=submission-documents
